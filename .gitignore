# =============================================================
# Python
# =============================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments (uv creates .venv/ with its own * .gitignore,
# but list it here too so tools that read the root file catch it)
.venv/
venv/
ENV/

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# =============================================================
# Node / Frontend
# =============================================================
node_modules/

# Vite production build output (regenerated by `npm run build`)
server/frontend/dist/

# =============================================================
# Blog post data  (runtime content — not source code)
#
# Live posts are stored in server/data/posts/{slug}.md and are
# managed at runtime.  The .gitkeep file keeps the directory
# tracked so the server can write to it on first run.
# =============================================================
server/data/posts/
server/data/posts.json
server/data/posts.json.migrated

# =============================================================
# Environment / secrets
# =============================================================
.env
.env.local
.env.*.local

# =============================================================
# OS / Editor
# =============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
Thumbs.db
*.swp
*.swo
*~
.idea/
