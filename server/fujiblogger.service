[Unit]
Description=FujiBlogger Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/fujiblogger/server
ExecStart=/usr/bin/uv run uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

# Override these in /etc/systemd/system/fujiblogger.service.d/local.conf
Environment=DATA_DIR=/opt/fujiblogger/server/data
Environment=PORT=8000
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
